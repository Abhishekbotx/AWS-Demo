pipeline {
    agent any

    
         stages {
        stage('Checkout') {
            steps {
                echo "Checking out code from Git..."
                // Fetch code from your GitHub repo (specific branch)
                git branch: 'main', url: 'https://github.com/Abhishekbotx/Jenkins-Setup.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo "Installing dependencies..."
                sh 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                echo "Running tests..."
                sh 'npm test'
            }
        }

        stage('Build') {
            steps {
                echo "Building the project..."
                sh 'npm run build || echo "No build step defined"'
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying application..."
                sh 'npm start &'
            }
        }
    }

    

}